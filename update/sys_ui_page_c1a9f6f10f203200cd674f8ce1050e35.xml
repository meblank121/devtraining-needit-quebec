    <sys_ui_page action="INSERT_OR_UPDATE">
        <category/>
        <client_script/>
        <description>Generic custom login page template.</description>
        <direct>true</direct>
        <endpoint>false</endpoint>
        <html><![CDATA[<div class="custom-login-page">
  <div class="custom-login-card">
    <h1>Sign In</h1>
    <p class="subtitle">Use your account credentials to continue.</p>

    <form class="custom-login-form" method="post">
      <label for="username">Username</label>
      <input id="username" name="username" type="text" placeholder="Username" required="true" />

      <label for="password">Password</label>
      <input id="password" name="password" type="password" placeholder="Password" required="true" />

      <button type="submit">Sign In</button>
    </form>
  </div>
</div>

<style>
  .custom-login-page {
    min-height: 100vh;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f4f6f9;
    padding: 24px;
    box-sizing: border-box;
  }

  .custom-login-card {
    width: 100%;
    max-width: 380px;
    background: #ffffff;
    border: 1px solid #dfe3e8;
    border-radius: 10px;
    padding: 28px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
    font-family: Arial, sans-serif;
  }

  .custom-login-card h1 {
    margin: 0;
    font-size: 26px;
    color: #1f2d3d;
    text-align: center;
  }

  .subtitle {
    margin: 8px 0 20px;
    color: #576574;
    text-align: center;
    font-size: 14px;
  }

  .custom-login-form {
    display: grid;
    gap: 8px;
  }

  .custom-login-form label {
    margin-top: 6px;
    font-size: 14px;
    color: #2f3e4d;
  }

  .custom-login-form input {
    border: 1px solid #c8d0da;
    border-radius: 6px;
    padding: 10px 12px;
    font-size: 14px;
  }

  .custom-login-form input:focus {
    border-color: #5b8def;
    outline: none;
    box-shadow: 0 0 0 3px rgba(91, 141, 239, 0.2);
  }

  .custom-login-form button {
    margin-top: 14px;
    border: 0;
    border-radius: 6px;
    padding: 10px 12px;
    color: #ffffff;
    background: #3d6dcc;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
  }

  .custom-login-form button:hover {
    background: #3057a5;
  }
</style>]]></html>
